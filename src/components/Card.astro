---
export interface Props {
  title: string;
  className?: string;
  style?: string;
}

const { title, className = "", style = "" } = Astro.props;
---

<div class={`card-component ${className} dark:bg-zinc-900 bg-white dark:border-none border-zinc-900 border`} style={style}>
  <div class="card-title">
    {title}
  </div>
  <div class="card-content">
    <slot />
  </div>
</div>

<style>
.card-component {
  @apply p-6 text-inherit;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 14px;
  font-family: 'Inter', 'Inter Regular', sans-serif;
}
.card-title {
  @apply font-bold pb-2;
  font-size: 2em;
}
.card-content {
    hyphens: auto;
    /*text-align: justify;*/
}
</style>
