---
import { Image } from 'astro:assets';
import terraIcon from '@/assets/terra.svg';
import { Combobox } from './ui/Combobox';
import { DarkModeToggle } from './ui/DarkModeToggle.tsx';
import { SearchBar } from './ui/SearchBar';
import { getVersions } from "../lib/versions";

export interface Props {
  search?: boolean;
}

const { search } = Astro.props;

let versions: CbValue[] = await getVersions();

---

<header class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-8 pb-16">
    <div class="relative flex h-16 items-center justify-between mt-2 sm:mt-0">
        <div class="flex flex-1 items-center justify-center sm:items-stretch sm:justify-start">
            <a class="flex flex-shrink-0 items-center" href="/">
                <Image
                  class="block h-14 w-auto drop-shadow-xl"
                  src={terraIcon}
                  alt="Terra Logo"
                  loading="eager"
                />
                <span class="font-bold hidden sm:inline">Terra <span class="font-normal">Hub</span></span>
            </a>
            <!-- Centered SearchBar component -->
            <div class="sm:flex-1 sm:flex sm:justify-center items-center px-4">
                {(search ?? true) && <SearchBar client:load />}
            </div>
            <div class="flex ml-auto place-items-stretch items-center">
                <div class="flex space-x-4 items-center h-full">
                    <a href="https://developer.fyralabs.com/terra/" class="text-gray-700 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 font-medium px-1 sm:px-3 py-1.5 sm:py-2 transition-colors">Docs</a>
                    <a href="https://github.com/terrapkg/packages/" class="text-gray-700 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 font-medium px-1 sm:px-3 py-1.5 sm:py-2 transition-colors">Sources</a>
                    <a href="https://wiki.ultramarine-linux.org/en/community/community/" class="text-gray-700 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 font-medium px-1 sm:px-3 py-1.5 sm:py-2 transition-colors">Community</a>

                    <DarkModeToggle client:load />
                </div>
            </div>
        </div>
    </div>
</header>
