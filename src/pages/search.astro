---
import Layout from '../layouts/Layout.astro';
import { SearchPanel } from '../components/ui/SearchPanel';
import { getVersions } from '../lib/versions';

const { searchParams } = Astro.url;
const query = searchParams.get('q') ?? '';
const repo = searchParams.get('repo') ?? '';
const arch = searchParams.get('arch') ?? '';
const versions = await getVersions();
---

<Layout title="Search | Terra Hub" search={false}>
        {query === ''
        ? <div class="flex flex-col items-center justify-center pb-20">
           <h1 class="text-4xl font-bold pb-4">Welcome to Terra Hub</h1>
          <h3 class="text-xl">Search for a package to get started</h3>
        </div>
        : <h1 class="text-4xl font-bold flex justify-center pb-10">Search Results for "{query}"</h1>
        }
    <SearchPanel versions={versions} initialQuery={query} initialRepo={repo} initialArch={arch} client:only="react" />
</Layout>
